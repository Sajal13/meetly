{
  "extends": "@meetly/typescript-config/nestjs.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@config/*": ["./src/config/*"],
      "@common/*": ["./src/common/*"],
      "@database/*": ["./src/database/*"],
      "@auth/*": ["./src/auth/*"],
      "@users/*": ["./src/users/*"],
      "@admin/*": ["./src/admin/*"],
      "@roles/*": ["./src/roles/*"],
      "@permissions/*": ["./src/permissions/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "src/database/migrations/.gitkeep"],
  "exclude": ["node_modules", "dist", "test"]
}
